  equipment     String?   @db.VarChar(200)
  description   String?   @db.Text
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  flow       FmeaProcessFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  pfmeaItems FmeaPfmeaItem[]

  @@index([flowId])
  @@map("fmea_process_flow_steps")
}

// ==================== PFMEA ====================

model FmeaPfmea {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId      Int       @db.UnsignedInt
  processFlowId  Int?      @db.UnsignedInt
  fmeaNo         String    @unique @db.VarChar(50)
  title          String    @db.VarChar(200)
  version        Int       @default(1)
  status         String    @default("draft") @db.VarChar(20)
  teamLeaderId   Int?      @db.UnsignedInt
  approvedById   Int?      @db.UnsignedInt
  approvedAt     DateTime?
  createdById    Int       @db.UnsignedInt
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      PrjProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  processFlow  FmeaProcessFlow?  @relation(fields: [processFlowId], references: [id])
  teamLeader   SysUser?          @relation("PfmeaTeamLeader", fields: [teamLeaderId], references: [id])
  approvedBy   SysUser?          @relation("PfmeaApprover", fields: [approvedById], references: [id])
  createdBy    SysUser           @relation("PfmeaCreator", fields: [createdById], references: [id])
  items        FmeaPfmeaItem[]

  @@index([projectId, status])
  @@map("fmea_pfmeas")
}

model FmeaPfmeaItem {
  id                    Int       @id @default(autoincrement()) @db.UnsignedInt
  pfmeaId               Int       @db.UnsignedInt
  processFlowStepId     Int?      @db.UnsignedInt
  processStep           String    @db.VarChar(200)
  failureMode           String?   @db.Text
  failureEffect         String?   @db.Text
  severityRating        Int       @default(1) @db.TinyInt
  failureCause          String?   @db.Text
  occurrenceRating      Int       @default(1) @db.TinyInt
  currentPreventionCtrl String?   @db.Text
  currentDetectionCtrl  String?   @db.Text
  detectionRating       Int       @default(1) @db.TinyInt
  apRating              String    @default("L") @db.VarChar(5)
  recommendedAction     String?   @db.Text
  actionStatus          String    @default("pending") @db.VarChar(20)
  actionResponsibleId   Int?      @db.UnsignedInt
  actionDueDate         DateTime?
  revisedSeverity       Int?      @db.TinyInt
  revisedOccurrence     Int?      @db.TinyInt
  revisedDetection      Int?      @db.TinyInt
  revisedAp             String?   @db.VarChar(5)
  controlPlanItemId     Int?      @db.UnsignedInt
  specialCharId         Int?      @db.UnsignedInt
  sortOrder             Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  pfmea             FmeaPfmea           @relation(fields: [pfmeaId], references: [id], onDelete: Cascade)
  processFlowStep   FmeaProcessFlowStep? @relation(fields: [processFlowStepId], references: [id])
  actionOwner       SysUser?            @relation("PfmeaActionOwner", fields: [actionResponsibleId], references: [id])

  @@index([pfmeaId])
  @@map("fmea_pfmea_items")
}

// ==================== Control Plan ====================

model FmeaControlPlan {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId   Int       @db.UnsignedInt
  cpNo        String    @unique @db.VarChar(50)
  title       String    @db.VarChar(200)
  cpType      String    @db.VarChar(30) // prototype/trial_production/mass_production
  partNumber  String?   @db.VarChar(100)
  partName    String?   @db.VarChar(200)
  status      String    @default("draft") @db.VarChar(20)
  version     Int       @default(1)
  approvedById Int?     @db.UnsignedInt
  approvedAt  DateTime?
  createdById Int       @db.UnsignedInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    PrjProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy SysUser?     @relation("CPApprover", fields: [approvedById], references: [id])
  createdBy  SysUser      @relation("CPCreator", fields: [createdById], references: [id])
  items      FmeaControlPlanItem[]

  @@index([projectId, cpType])
  @@map("fmea_control_plans")
}

model FmeaControlPlanItem {
  id                  Int       @id @default(autoincrement()) @db.UnsignedInt
  controlPlanId       Int       @db.UnsignedInt
  partProcessName     String?   @db.VarChar(200)
  characteristicDesc  String?   @db.VarChar(500)
  specificationTol    String?   @db.VarChar(500)
  measurementMethod   String?   @db.VarChar(200)
  sampleSize          String?   @db.VarChar(50)
  sampleFrequency     String?   @db.VarChar(50)
  controlMethod       String?   @db.VarChar(200)
  reactionPlan        String?   @db.Text
  specialCharId       Int?      @db.UnsignedInt
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  controlPlan FmeaControlPlan @relation(fields: [controlPlanId], references: [id], onDelete: Cascade)

  @@index([controlPlanId])
  @@map("fmea_control_plan_items")
}

// ==================== Special Characteristics ====================

model FmeaSpecialCharacteristic {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId   Int       @db.UnsignedInt
  charCode    String    @db.VarChar(50)
  charName    String    @db.VarChar(200)
  charType    String    @db.VarChar(10) // CC/SC
  source      String?   @db.VarChar(30) // customer/internal/regulatory/design
  description String?   @db.Text
  status      String    @default("active") @db.VarChar(20) // active/superseded/deleted
  createdById Int       @db.UnsignedInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   PrjProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy SysUser   @relation("SpecCharCreator", fields: [createdById], references: [id])

  @@index([projectId, charType])
  @@map("fmea_special_characteristics")
}

// ==================== SPC ====================

model QeSpcStudy {
  id                  Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId           Int       @db.UnsignedInt
  studyNo             String    @unique @db.VarChar(50)
  characteristicName  String    @db.VarChar(200)
  chartType           String    @db.VarChar(20) // xbar_r/xbar_s/p/np/c/u/i_mr
  subgroupSize        Int       @default(5) @db.UnsignedInt
  usl                 Decimal?  @db.Decimal(14, 6)
  lsl                 Decimal?  @db.Decimal(14, 6)
  ucl                 Decimal?  @db.Decimal(14, 6)
  lcl                 Decimal?  @db.Decimal(14, 6)
  cp                  Decimal?  @db.Decimal(8, 4)
  cpk                 Decimal?  @db.Decimal(8, 4)
  pp                  Decimal?  @db.Decimal(8, 4)
  ppk                 Decimal?  @db.Decimal(8, 4)
  capabilityResult  String?   @db.VarChar(20) // capable/marginal/incapable
  specialCharId       Int?      @db.UnsignedInt
  createdById         Int       @db.UnsignedInt
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project   PrjProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy SysUser           @relation("SpcStudyCreator", fields: [createdById], references: [id])
  dataPoints QeSpcDataPoint[]

  @@index([projectId])
  @@map("qe_spc_studies")
}

model QeSpcDataPoint {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  studyId       Int       @db.UnsignedInt
  subgroupNo    Int       @db.UnsignedInt
  sampleValues  Json?     // array of individual measurements
  subgroupMean  Decimal?  @db.Decimal(14, 6)
  subgroupRange Decimal?  @db.Decimal(14, 6)
  subgroupStd   Decimal?  @db.Decimal(14, 6)
  isOutOfControl Boolean  @default(false)
  violationRule String?   @db.VarChar(50)
  createdAt     DateTime  @default(now())

  study QeSpcStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId, subgroupNo])
  @@map("qe_spc_data_points")
}

// ==================== MSA ====================

model QeMsaStudy {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId       Int       @db.UnsignedInt
  studyNo         String    @unique @db.VarChar(50)
  studyType       String    @db.VarChar(20) // grr/bias/linearity/stability/attribute
  gageName        String    @db.VarChar(200)
  numOperators    Int       @default(3) @db.UnsignedInt
  numTrials       Int       @default(3) @db.UnsignedInt
  numParts        Int       @default(10) @db.UnsignedInt
  tolerance       Decimal?  @db.Decimal(14, 6)
  evPercent       Decimal?  @db.Decimal(8, 4) // Equipment Variation %
  avPercent       Decimal?  @db.Decimal(8, 4) // Appraiser Variation %
  grrPercent      Decimal?  @db.Decimal(8, 4) // GR&R %
  pvPercent       Decimal?  @db.Decimal(8, 4) // Part Variation %
  tvPercent       Decimal?  @db.Decimal(8, 4) // Total Variation %
  ndc             Int?      @db.UnsignedInt // Number of Distinct Categories
  biasValue       Decimal?  @db.Decimal(14, 6)
  acceptanceResult String?  @db.VarChar(20) // acceptable/marginal/unacceptable
  createdById     Int       @db.UnsignedInt
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project      PrjProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    SysUser             @relation("MsaStudyCreator", fields: [createdById], references: [id])
  measurements QeMsaMeasurement[]

  @@index([projectId])
  @@map("qe_msa_studies")
}

model QeMsaMeasurement {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  studyId         Int       @db.UnsignedInt
  operatorId      Int       @db.UnsignedInt
  partId          Int       @db.UnsignedInt
  trialNo         Int       @db.UnsignedInt
  measuredValue   Decimal   @db.Decimal(14, 6)
  referenceValue  Decimal?  @db.Decimal(14, 6)
  createdAt       DateTime  @default(now())

  study    QeMsaStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  operator SysUser    @relation("MsaOperator", fields: [operatorId], references: [id])

  @@index([studyId])
  @@map("qe_msa_measurements")
}

// ==================== FMEA Knowledge Base ====================

model FmeaKnowledgeBase {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  entryType         String    @db.VarChar(30) // failure_mode/cause/control/severity_ref/occurrence_ref/detection_ref
  category          String?   @db.VarChar(100)
  title             String    @db.VarChar(200)
  description       String?   @db.Text
  suggestedSeverity Int?      @db.TinyInt
  suggestedOccurrence Int?    @db.TinyInt
  suggestedDetection  Int?    @db.TinyInt
  applicableFmeaType String?  @db.VarChar(20) // dfmea/pfmea/both
  tags              String?   @db.VarChar(500)
  usageCount        Int       @default(0) @db.UnsignedInt
  createdById       Int       @db.UnsignedInt
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy SysUser @relation("KBEntryCreator", fields: [createdById], references: [id])

  @@index([entryType, category])
  @@index([tags(length: 100)])
  @@map("fmea_knowledge_base")
}

// ============================================================
// Phase 7: Change Management (ECR/ECN)
// ============================================================

model ChgEcr {
  id                      Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId               Int       @db.UnsignedInt
  ecrCode                 String    @unique @db.VarChar(50)
  title                   String    @db.VarChar(200)
  description             String?   @db.Text
  changeType              String    @db.VarChar(20) // design/process/material/specification/plan/schedule/cost
  priority                String    @default("general") @db.VarChar(10) // critical/major/general/minor
  status                  String    @default("draft") @db.VarChar(20) // draft/submitted/impact_analysis/ccb_review/approved/rejected/closed
  reason                  String?   @db.Text
  currentCondition        String?   @db.Text
  proposedChange          String?   @db.Text
  requesterId             Int       @db.UnsignedInt
  assignedToId            Int?      @db.UnsignedInt
  submittedAt             DateTime?
  approvedAt              DateTime?
  closedAt                DateTime?
  targetDate              DateTime?
  estimatedCost           Decimal?  @db.Decimal(12, 2)
  safetyRelated           Boolean   @default(false)
  customerNotified        Boolean   @default(false)
  ppapResubmissionRequired Boolean  @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  project       PrjProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester     SysUser             @relation("EcrRequester", fields: [requesterId], references: [id])
  assignedTo    SysUser?            @relation("EcrAssignee", fields: [assignedToId], references: [id])
  impactItems   ChgEcrImpactItem[]
  ccbReviews    ChgCcbReview[]
  ecns          ChgEcn[]

  @@index([projectId, status])
  @@index([changeType])
  @@index([priority])
  @@map("chg_ecrs")
}

model ChgEcrImpactItem {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  ecrId          Int      @db.UnsignedInt
  impactArea     String   @db.VarChar(30) // bom/fmea/sample/cost/document/tooling/safety/process/control_plan/spc/msa/ppap
  affectedItem   String?  @db.VarChar(200)
  impactLevel    String   @db.VarChar(10) // high/medium/low
  description    String?  @db.Text
  actionRequired String?  @db.Text
  relatedDocId   Int?     @db.UnsignedInt
  sortOrder      Int      @default(0) @db.TinyInt

  ecr            ChgEcr   @relation(fields: [ecrId], references: [id], onDelete: Cascade)

  @@index([ecrId])
  @@map("chg_ecr_impact_items")
}

model ChgCcbReview {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  ecrId          Int       @db.UnsignedInt
  reviewDate     DateTime  @default(now())
  reviewerId     Int       @db.UnsignedInt
  decision       String    @db.VarChar(20) // approve/reject/conditional/defer
  opinion        String?   @db.Text
  conditions     String?   @db.Text
  nextReviewDate DateTime?

  ecr            ChgEcr    @relation(fields: [ecrId], references: [id], onDelete: Cascade)
  reviewer       SysUser   @relation("CcbReviewer", fields: [reviewerId], references: [id])

  @@index([ecrId])
  @@map("chg_ccb_reviews")
}

model ChgEcn {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId     Int       @db.UnsignedInt
  ecnCode       String    @unique @db.VarChar(50)
  ecrId         Int       @db.UnsignedInt
  title         String    @db.VarChar(200)
  description   String?   @db.Text
  status        String    @default("planning") @db.VarChar(20) // planning/executing/verifying/closed
  effectiveDate DateTime?
  issuedById    Int       @db.UnsignedInt
  verifiedById  Int?      @db.UnsignedInt
  verifiedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       PrjProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ecr           ChgEcr          @relation(fields: [ecrId], references: [id])
  issuedBy      SysUser         @relation("EcnIssuer", fields: [issuedById], references: [id])
  verifiedBy    SysUser?        @relation("EcnVerifier", fields: [verifiedById], references: [id])
  actionItems   ChgEcnActionItem[]

  @@index([projectId, status])
  @@index([ecrId])
  @@map("chg_ecns")
}

model ChgEcnActionItem {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  ecnId           Int       @db.UnsignedInt
  actionType      String    @db.VarChar(30) // update_bom/update_fmea/update_control_plan/update_drawing/update_process/update_ppap/update_document/tooling_change/sample_verification/other
  description     String    @db.VarChar(500)
  assignedToId    Int?      @db.UnsignedInt
  status          String    @default("pending") @db.VarChar(20) // pending/in_progress/completed/verified
  dueDate         DateTime?
  completedAt     DateTime?
  verificationNote String?  @db.Text
  sortOrder       Int       @default(0) @db.TinyInt

  ecn             ChgEcn    @relation(fields: [ecnId], references: [id], onDelete: Cascade)
  assignedTo      SysUser?  @relation("EcnActionAssignee", fields: [assignedToId], references: [id])

  @@index([ecnId])
  @@map("chg_ecn_action_items")
}

// ============================================================
// Layer 11: Quality Enhancement (Phase 9)
// ============================================================

// ==================== Escalation History ====================

model QualityEscalationHistory {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  problemId         Int       @db.UnsignedInt
  fromStatus        String    @db.VarChar(20)
  toStatus          String    @db.VarChar(20)
  escalationLevel   String    @db.VarChar(10) // L1/L2/L3
  severity          String    @db.VarChar(20)
  daysOpen          Int       @db.UnsignedInt
  escalateTo        String    @db.VarChar(50)
  alertRecordId     Int?      @db.UnsignedInt
  triggeredBy       String    @db.VarChar(10) // auto/manual
  triggeredById     Int?      @db.UnsignedInt
  remark            String?   @db.Text
  createdAt         DateTime  @default(now())

  problem           QualityProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  triggeredByUser   SysUser?       @relation("EscalationTriggerUser", fields: [triggeredById], references: [id])

  @@index([problemId])
  @@index([escalationLevel])
  @@map("quality_escalation_history")
}

// ==================== PPM Records ====================

model QualityPpmRecord {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId       Int       @db.UnsignedInt
  period          String    @db.VarChar(20) // 2026-01, 2026-Q1, 2026
  periodType      String    @db.VarChar(10) // monthly/quarterly/yearly
  totalParts      Int       @default(0) @db.UnsignedInt
  defectParts     Int       @default(0) @db.UnsignedInt
  ppmValue        Decimal   @default(0) @db.Decimal(12, 2)
  targetPpm       Decimal   @default(0) @db.Decimal(12, 2)
  status          String    @default("on_track") @db.VarChar(20) // on_track/warning/exceeded
  createdById     Int       @db.UnsignedInt
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         PrjProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       SysUser    @relation("PpmRecordCreator", fields: [createdById], references: [id])

  @@unique([projectId, period])
  @@index([projectId])
  @@index([periodType])
  @@map("quality_ppm_records")
}
