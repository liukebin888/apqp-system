  linkType       String    @db.VarChar(10) // derive/allocate/implement/verify/trace
  verificationMethod String? @db.VarChar(20) // test/analysis/demonstration/inspection
  status         String    @default("active") @db.VarChar(20) // active/suspended/obsolete
  createdAt      DateTime  @default(now())

  sourceReq ReqRequirement @relation("SourceRequirement", fields: [sourceReqId], references: [id], onDelete: Cascade)
  targetReq ReqRequirement? @relation("TargetRequirement", fields: [targetReqId], references: [id])

  @@index([sourceReqId])
  @@index([targetReqId])
  @@index([linkType])
  @@map("req_trace_links")
}

model ReqBaseline {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId    Int       @db.UnsignedInt
  baselineName String    @db.VarChar(100)
  baselineCode String    @db.VarChar(50)
  baselineType String    @db.VarChar(20) // functional/allocated/product
  version      String    @db.VarChar(20)
  status       String    @default("draft") @db.VarChar(20) // draft/frozen/changed
  description  String?   @db.Text
  createdById  Int       @db.UnsignedInt
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

