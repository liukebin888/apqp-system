  priority        String    @default("medium") @db.VarChar(10)
  status          String    @default("draft") @db.VarChar(20) // draft/submitted/under_review/approved/rejected/implemented
  requestedById   Int       @db.UnsignedInt
  approvedById    Int?      @db.UnsignedInt
  approvedAt      DateTime?
  implementedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project      PrjProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements ReqChangeRequestRequirement[]

  @@index([projectId, status])
  @@map("req_change_requests")
}

model ReqChangeRequestRequirement {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  changeRequestId Int      @db.UnsignedInt
  requirementId  Int       @db.UnsignedInt

  changeRequest ReqChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  requirement   ReqRequirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([changeRequestId, requirementId])
  @@map("req_change_request_requirements")
}

model ReqCoverageAnalysis {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
