  requirements ReqBaselineRequirement[]

  @@unique([projectId, baselineCode])
  @@map("req_baselines")
}

model ReqBaselineRequirement {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  baselineId   Int       @db.UnsignedInt
  requirementId Int      @db.UnsignedInt
  reqVersion   Int       @default(1) // snapshot of requirement version at baseline time

  baseline    ReqBaseline    @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  requirement ReqRequirement @relation(fields: [requirementId], references: [id])

  @@unique([baselineId, requirementId])
  @@map("req_baseline_requirements")
}

model ReqChangeRequest {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId       Int       @db.UnsignedInt
  crCode          String    @db.VarChar(50)
  title           String    @db.VarChar(200)
  description     String?   @db.Text
  changeType      String    @db.VarChar(20) // add/modify/delete
