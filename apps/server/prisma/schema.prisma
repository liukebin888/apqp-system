// ============================================================
// Layer 4: A-SPICE Requirements & Traceability (V2.5)
// ============================================================

model ReqRequirement {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  projectId   Int       @db.UnsignedInt
  reqCode     String    @db.VarChar(50)
  title       String    @db.VarChar(200)
  description String?   @db.Text
  reqType     String    @db.VarChar(20) // customer/system/software/performance/safety/regulatory
  priority    String    @default("medium") @db.VarChar(10) // high/medium/low
  asilLevel   String?   @db.VarChar(5) // QM/A/B/C/D
  status      String    @default("draft") @db.VarChar(20) // draft/in_review/approved/changed/obsolete
  version     Int       @default(1)
  source      String?   @db.VarChar(200) // source document or reference
  acceptanceCriteria String? @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project      PrjProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     ReqRequirementVersion[]
  sourceLinks  ReqTraceLink[]       @relation("SourceRequirement")
  targetLinks  ReqTraceLink[]       @relation("TargetRequirement")
