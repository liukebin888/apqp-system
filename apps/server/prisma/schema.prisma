  @@index([projectId])
  @@index([reqType, status])
  @@map("req_requirements")
}

model ReqRequirementVersion {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  requirementId  Int       @db.UnsignedInt
  versionNo      Int
  title          String    @db.VarChar(200)
  description    String?   @db.Text
  changeNote     String?   @db.VarChar(500)
  createdById    Int       @db.UnsignedInt
  createdAt      DateTime  @default(now())

  requirement ReqRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, versionNo])
  @@map("req_requirement_versions")
}

model ReqTraceLink {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  sourceReqId    Int       @db.UnsignedInt
  targetReqId    Int?      @db.UnsignedInt
  targetType     String    @db.VarChar(20) // requirement/test_case/design/code
